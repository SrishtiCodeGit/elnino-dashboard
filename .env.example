# Copy to .env.local and fill in what you need. The map, scores, backtest
# panel and live weather/drought layer work with none of these.

# Agent Report chat, AI summaries, PDF analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Emailed PDF reports (https://resend.com). The sandbox sender below only
# delivers to your own Resend account email until you verify a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMS alerts (https://dashboard.nexmo.com). FROM number in digits, e.g. 15551234567
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=

# Numbers allowed to receive texts, comma-separated +E.164. Unset = nobody.
SMS_ALLOWLIST=
